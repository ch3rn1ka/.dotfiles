#!/bin/sh
# create-backup - save important files to a USB via rsync

set -e

MUSIC=$(xdg-user-dir MUSIC)
DOCS=$(xdg-user-dir DOCUMENTS)
PASS="$PASSWORD_STORE_DIR"
UNI="$HOME/uni"

# Package a git repo into a bundle, then copy
backup_projects()
{
    printf '%s\n' "Backing up $PROGRAMMING"

    dest="$BACKUP_ROOT/clonebay"
    [ -d "$dest" ] || mkdir "$dest"

    for repo in "$PROGRAMMING/"*/; do
        repo_name=$(printf '%s\n' "$repo" | sed 's|.$||; s|.*/||g')
        printf '\t%s\n' "Creating a bundle for $repo_name"
        git -C "$repo" bundle create "$repo_name.bundle" --all >/dev/null 2>&1
        rsync -q "$repo/$repo_name.bundle" "$dest"
        rm "$repo/$repo_name.bundle"
    done
}

backup_generic()
{
    printf '%s\n' "Backing up $1"
    rsync -q --archive --no-links "$1" "$BACKUP_ROOT"
}

main()
{
    [ $# -eq 0 ] || [ $# -gt 1 ] && {
        printf '%s\n' 'Usage: ./create-backup DEST'
        exit 1
    }

    BACKUP_ROOT="$1"
    [ -d "$BACKUP_ROOT" ] && [ -w "$BACKUP_ROOT" ] || {
        printf 'Cannot write to %s.\n' "$path"
        exit 1
    }
    printf '%s\n' "Target: $BACKUP_ROOT"

    backup_projects

    set -- "$MUSIC" "$DOCS" "$PASS" "$UNI"
    for path in "$@"; do
        backup_generic "$path"
    done
    printf '%s\n' 'Finished.'
}

main "$@"
