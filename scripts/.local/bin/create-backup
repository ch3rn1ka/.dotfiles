#!/bin/sh

set -e

MUSIC=$(xdg-user-dir MUSIC)
DOCS=$(xdg-user-dir DOCUMENTS)
PROJECTS=$(xdg-user-dir PROJECTS)
PASS="$PASSWORD_STORE_DIR"
UNI="$HOME/uni"

backup_projects()
{
    PROGRAMMING="$PROJECTS/programming"
    printf '%s\n' "Backing up $PROGRAMMING"

    dest="$BACKUP_ROOT/clonebay"
    [ -d "$dest" ] || mkdir "$dest"

    for repo in "$PROGRAMMING/"*/; do
        [ -e "$repo" ] || continue

        git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1 || continue

        repo_name=$(printf '%s\n' "$repo" | sed 's|.$||; s|.*/||g')
        printf '\t%s\n' "Creating a bundle for $repo_name"

        git -C "$repo" bundle create "$repo_name.bundle" --all >/dev/null 2>&1 || true

        if [ -f "$repo/$repo_name.bundle" ]; then
            rsync -q "$repo/$repo_name.bundle" "$dest" || true
            rm "$repo/$repo_name.bundle"
        fi
    done
}

backup_generic()
{
    [ -e "$1" ] || return 0
    printf '%s\n' "Backing up $1"
    rsync -q --archive --no-links "$1" "$BACKUP_ROOT" || true
}

main()
{
    [ $# -eq 0 ] || [ $# -gt 1 ] && {
        printf '%s\n' 'Usage: ./create-backup DEST'
        exit 1
    }

    BACKUP_ROOT="$1"
    [ -d "$BACKUP_ROOT" ] && [ -w "$BACKUP_ROOT" ] || {
        printf 'Cannot write to %s.\n' "$BACKUP_ROOT"
        exit 1
    }
    printf '%s\n' "Target: $BACKUP_ROOT"

    backup_projects

    set -- "$MUSIC" "$DOCS" "$PASS" "$UNI"
    for path in "$@"; do
        backup_generic "$path"
    done
    printf '%s\n' 'Finished.'
}

main "$@"
