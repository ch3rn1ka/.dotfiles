#!/bin/sh
set -e

VIDEOS_DIR=$(xdg-user-dir VIDEOS)
VIDEOS_LIST=$(ls "$VIDEOS_DIR")

spawn_menu()
{
    printf '%s' "$1" | bemenu --prompt "$2" --list 20
}

# Select an arbitrarily nested file in a given folder
select_file()
{
    selection=$(spawn_menu "$(ls "$1")" 'Choose a file/go down a directory:')
    selection_path="$1/$selection"
    selection_list=$(ls "$selection_path")

    if [ -f "$selection_path" ]; then
        echo "$selection_path"
    elif [ -n "$selection_list" ]; then
        select_file "$selection_path"
    else
        exit 1
    fi
}

select_dir()
{
    dir=$(spawn_menu "$VIDEOS_LIST" 'Select a directory:')
    echo "$VIDEOS_DIR/$dir"
}

main()
{
    options=$(printf '%s\n' 'Select a file' 'Select a directory')
    response=$(spawn_menu "$options" 'Play one or multiple files?')
    selection=''
    case "$response" in
        'Select a file') selection=$(select_file "$VIDEOS_DIR") ;;
        'Select a directory') selection=$(select_dir) ;;
    esac

    mpv "$selection" >/dev/null 2>&1
}

main "$@"
