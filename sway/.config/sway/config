### Variables
set $mod Mod4
set $left h
set $down j
set $up k
set $right l

### Output configuration
output * bg $(xdg-user-dir PICTURES)/wallpapers/the-ninth-wave-gruvbox.jpg fill

### Decorations
# Basics:
smart_gaps on
smart_borders on
default_border normal 1
font pango:"UbuntuMono Nerd Font" 10

# Colors:
# class                 border  backgr. text    indicator child_border
client.focused          #458588 #285577 #fbf1c7 #2e9ef4   #4c7899
client.focused_inactive #7c6f64 #504945 #ebdbb2 #484e50   #7c6f64
client.unfocused        #32302f #222222 #a89984 #292d2e   #222222
client.urgent           #fb4934 #cc241d #fbf1c7 #cc241d   #fb4934
client.placeholder      #000000 #0c0c0c #ebdbb2 #000000   #0c0c0c
client.background       #282828

### Windowrules
assign [app_id=".*qutebrowser.*"] 1
assign [app_id=".*telegram.*"] 3
assign [class=".*discord*."] 4
assign [app_id=".*libreoffice.*"] 5
assign [app_id=".*gimp.*"] 6
assign [class=".*Ardour.*"] 7
assign [class=".*steam*."] 8
assign [app_id=".*obsproject.*"] 9

### XWayland
xwayland enable
for_window [shell="xwayland"] title_format "[XWayland] %title"

### Autostart
exec mako >/dev/null 2>&1
exec makoctl mode -s sway >/dev/null 2>&1
exec emacs --daemon >/dev/null 2>&1
exec wl-paste --watch cliphist store
exec ydotoold >/dev/null 2>&1
exec mpdris2-rs >/dev/null 2>&1
exec playerctld daemon >/dev/null 2>&1
exec swayidle -w \
      timeout 1200 "swaylock -f -c 282828" \
      timeout 4800 "swaymsg 'output * power off'" resume "swaymsg 'output * power on'" \
      before-sleep "swaylock -f -c 282828"

### Input configuration
input "type:touchpad" {
      dwt enabled
      tap enabled
      natural_scroll enabled
      middle_emulation enabled
      drag_lock disabled
}

input "type:keyboard" {
      xkb_layout us,ru
      xkb_options "ctrl:nocaps"
      repeat_delay 400
      repeat_rate 40
}

### Status Bar:
bar {
        position bottom
        height 26
        font UbuntuMono Nerd Font

        colors {
                statusline #ebdbb2
                separator #fbf1c7
                background #222222
                active_workspace #458588  #285577 #fbf1c7
                inactive_workspace #3c3836 #3c3836 #ebdbb2
                urgent_workspace #fb4934 #cc231d #fbf1c7
        }

        status_command i3status
}

include "$HOME"/.config/sway/binds
include /etc/sway/config.d/*
