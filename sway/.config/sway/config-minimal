# A purposefully stripped-down version of swayconf that doesn't autostart any
# apps. Useful when launching a game on machines where every MB counts.

### Variables
set $mod Mod4
set $left h
set $down j
set $up k
set $right l

### Decorations
# Basics:
smart_gaps on
smart_borders on
default_border pixel 1

### Windowrules
assign [app_id=".*qutebrowser.*"] 1
assign [app_id=".*telegram.*"] 3
assign [class=".*discord*."] 4
assign [app_id=".*libreoffice.*"] 5
assign [app_id=".*gimp.*"] 6
assign [class=".*Ardour.*"] 7
assign [class=".*steam*."] 8
assign [app_id=".*obsproject.*"] 9

### XWayland
xwayland enable
for_window [shell="xwayland"] title_format "[XWayland] %title"

### Input configuration
input "type:touchpad" {
      dwt enabled
      tap enabled
      natural_scroll enabled
      middle_emulation enabled
      drag_lock disabled
}

input "type:keyboard" {
      xkb_layout us,ru
      xkb_options "grp:win_space_toggle,ctrl:nocaps"
      repeat_delay 400
      repeat_rate 40
}

include "$HOME"/.config/sway/binds
include /etc/sway/config.d/*

